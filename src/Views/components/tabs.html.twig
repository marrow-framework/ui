<div x-data="{ tab: '{{ defaultTab }}' }" class="{{ class }}">
    <div class="flex gap-1 border-b border-slate-800" role="tablist">
        {% for t in tabs %}
        <button
            type="button"
            role="tab"
            @click="tab = '{{ t.id }}'"
            :class="tab === '{{ t.id }}' ? 'border-orange-400 text-slate-50' : 'border-transparent text-slate-400 hover:text-slate-200'"
            class="border-b-2 px-4 py-2 text-sm font-medium transition"
        >
            {{ t.label }}
        </button>
        {% endfor %}
    </div>
    {% for t in tabs %}
    <div x-show="tab === '{{ t.id }}'" role="tabpanel" class="py-4 text-sm text-slate-300">
        {{ t.content|raw }}
    </div>
    {% endfor %}
</div>
