{% set maxWidthClasses = {'sm': 'max-w-sm', 'md': 'max-w-md', 'lg': 'max-w-lg', 'xl': 'max-w-xl'} %}
{% set maxWidthClass = maxWidthClasses[maxWidth|default('md')] ?? maxWidthClasses.md %}

<div x-data="{ open: false }" class="inline-block">
    <span @click="open = true">{% block trigger %}{{ trigger|default('')|raw }}{% endblock %}</span>

    <div
        x-show="open"
        x-cloak
        @keydown.escape.window="open = false"
        class="fixed inset-0 z-50 flex items-center justify-center p-4"
    >
        <div x-show="open" x-transition.opacity class="fixed inset-0 bg-slate-950/70" @click="open = false"></div>

        <div
            x-show="open"
            x-transition
            class="relative w-full {{ maxWidthClass }} rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-2xl"
        >
            <button @click="open = false" class="absolute right-4 top-4 text-slate-500 hover:text-slate-300" aria-label="Fermer">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
                </svg>
            </button>

            {% if title|default(null) %}<h2 class="mb-4 pr-6 text-lg font-semibold text-slate-50">{{ title }}</h2>{% endif %}

            <div class="text-sm text-slate-300">
                {% block body %}{{ slot|default('')|raw }}{% endblock %}
            </div>
        </div>
    </div>
</div>
