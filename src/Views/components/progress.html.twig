{% import "@ui/macros/attrs.html.twig" as attrs_macro %}
<div class="h-2 w-full overflow-hidden rounded-full bg-slate-800 {{ class }}"{{ attrs_macro.render(attrs) }} role="progressbar" aria-valuenow="{{ value }}" aria-valuemin="0" aria-valuemax="{{ max }}">
    <div class="h-full rounded-full bg-orange-500 transition-all" style="width: {{ percent }}%"></div>
</div>
