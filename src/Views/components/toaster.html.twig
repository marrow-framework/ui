{% set serverToasts = [] %}

{% set flashStatus = session_flash('status') %}
{% if flashStatus %}{% set serverToasts = serverToasts|merge([{type: 'success', message: flashStatus}]) %}{% endif %}

{% set flashError = session_flash('error') %}
{% if flashError %}{% set serverToasts = serverToasts|merge([{type: 'error', message: flashError}]) %}{% endif %}

{% for n in toast_notifications() %}
    {% set serverToasts = serverToasts|merge([{type: n.type, message: n.message}]) %}
{% endfor %}

<div
    x-data
    class="pointer-events-none fixed inset-x-0 bottom-4 z-[100] flex flex-col items-center gap-2 px-4 sm:inset-x-auto sm:right-4 sm:items-end"
>
    <template x-for="t in $store.toaster.toasts" :key="t.id">
        <div
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            class="pointer-events-auto flex w-full max-w-sm items-center gap-3 rounded-lg border px-4 py-3 text-sm shadow-xl"
            :class="{
                'border-emerald-500/30 bg-emerald-950 text-emerald-300': t.type === 'success',
                'border-red-500/30 bg-red-950 text-red-300': t.type === 'error',
                'border-amber-500/30 bg-amber-950 text-amber-300': t.type === 'warning',
                'border-sky-500/30 bg-sky-950 text-sky-300': t.type === 'info',
            }"
        >
            <span class="flex-1" x-text="t.message"></span>
            <button type="button" @click="$store.toaster.dismiss(t.id)" class="shrink-0 opacity-60 hover:opacity-100" aria-label="Fermer">
                &#10005;
            </button>
        </div>
    </template>
</div>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.store('toaster', {
        toasts: [],
        push(type, message, duration) {
            const id = Date.now() + Math.random();
            this.toasts.push({ id, type, message });
            setTimeout(() => this.dismiss(id), duration || 4000);
        },
        dismiss(id) {
            this.toasts = this.toasts.filter((t) => t.id !== id);
        },
    });

    window.toast = {
        success: (message, duration) => Alpine.store('toaster').push('success', message, duration),
        error: (message, duration) => Alpine.store('toaster').push('error', message, duration),
        info: (message, duration) => Alpine.store('toaster').push('info', message, duration),
        warning: (message, duration) => Alpine.store('toaster').push('warning', message, duration),
    };

    const serverToasts = {{ serverToasts|json_encode|raw }};
    serverToasts.forEach((t) => (window.toast[t.type] || window.toast.info)(t.message));
});
</script>
