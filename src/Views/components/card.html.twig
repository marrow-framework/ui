<div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-900 {{ class }}">
    {% if title %}
    <div class="border-b border-slate-800 px-5 py-4">
        <h3 class="text-sm font-semibold text-slate-50">{{ title }}</h3>
    </div>
    {% endif %}
    <div class="px-5 py-4 text-sm text-slate-300">
        {{ slot|raw }}
    </div>
    {% if footer %}
    <div class="border-t border-slate-800 bg-slate-950/40 px-5 py-3">
        {{ footer|raw }}
    </div>
    {% endif %}
</div>
