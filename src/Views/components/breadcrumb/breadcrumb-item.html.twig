{% import "@ui/macros/attrs.html.twig" as attrs_macro %}
<li class="flex items-center {{ class }}"{{ attrs_macro.render(attrs) }}>
    {% if href %}
        <a href="{{ href }}" class="hover:text-orange-300">{{ slot|raw }}</a>
    {% else %}
        <span class="text-slate-200" aria-current="page">{{ slot|raw }}</span>
    {% endif %}
</li>
