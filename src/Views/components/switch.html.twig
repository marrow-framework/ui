<label for="{{ id }}" class="inline-flex items-center gap-2 {{ disabled ? 'cursor-not-allowed opacity-50' : 'cursor-pointer' }} {{ class }}">
    <span class="relative inline-flex h-6 w-11 shrink-0 items-center">
        <input
            type="checkbox"
            name="{{ name }}"
            id="{{ id }}"
            value="{{ value }}"
            {% if checked %}checked{% endif %}
            {% if disabled %}disabled{% endif %}
            class="peer sr-only"
        >
        <span class="pointer-events-none absolute inset-0 rounded-full bg-slate-700 transition peer-checked:bg-orange-500"></span>
        <span class="pointer-events-none absolute left-0.5 h-5 w-5 translate-x-0 rounded-full bg-white transition peer-checked:translate-x-5"></span>
    </span>
    {% if label %}<span class="text-sm text-slate-300">{{ label }}</span>{% endif %}
</label>
