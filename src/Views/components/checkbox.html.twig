{% import "@ui/macros/attrs.html.twig" as attrs_macro %}
<label for="{{ id }}" class="inline-flex items-center gap-2 {{ disabled ? 'cursor-not-allowed opacity-50' : 'cursor-pointer' }} {{ class }}">
    <input
        type="checkbox"
        name="{{ name }}"
        id="{{ id }}"
        value="{{ value }}"
        {% if checked %}checked{% endif %}
        {% if disabled %}disabled{% endif %}
        class="h-4 w-4 rounded border-slate-700 bg-slate-900 text-orange-500 focus:ring-orange-400 focus:ring-offset-slate-950"{{ attrs_macro.render(attrs) }}
    >
    {% if label %}<span class="text-sm text-slate-300">{{ label }}</span>{% endif %}
</label>
