<textarea
    name="{{ name }}"
    id="{{ id }}"
    rows="{{ rows }}"
    placeholder="{{ placeholder }}"
    {% if disabled %}disabled{% endif %}
    class="w-full rounded-lg border bg-slate-900 px-3 py-2 text-slate-100 placeholder:text-slate-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50 {{ error ? 'border-red-500 focus:border-red-400' : 'border-slate-700 focus:border-orange-400' }} {{ class }}"
>{{ value }}</textarea>
