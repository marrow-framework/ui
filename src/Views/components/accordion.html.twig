<div x-data="{ openIndex: null }" class="divide-y divide-slate-800 rounded-lg border border-slate-800 {{ class }}">
    {% for item in items %}
    <div>
        <button
            type="button"
            @click="openIndex = (openIndex === {{ loop.index0 }} ? null : {{ loop.index0 }})"
            class="flex w-full items-center justify-between px-4 py-3 text-left text-sm font-medium text-slate-100 hover:bg-slate-900"
        >
            {{ item.title }}
            <svg class="h-4 w-4 shrink-0 text-slate-500 transition-transform" :class="openIndex === {{ loop.index0 }} ? 'rotate-180' : ''" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
        </button>
        <div x-show="openIndex === {{ loop.index0 }}" x-transition class="px-4 pb-4 text-sm text-slate-400">
            {{ item.content|raw }}
        </div>
    </div>
    {% endfor %}
</div>
