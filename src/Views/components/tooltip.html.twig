{% import "@ui/macros/attrs.html.twig" as attrs_macro %}
<span class="group relative inline-block {{ class|default('') }}"{{ attrs_macro.render(attrs|default({})) }}>
    {{ trigger|raw }}
    <span class="pointer-events-none absolute z-50 whitespace-nowrap rounded-md bg-slate-800 px-2 py-1 text-xs text-slate-100 opacity-0 shadow-lg transition group-hover:opacity-100 {{ sideClasses }}">
        {{ slot|raw }}
    </span>
</span>
