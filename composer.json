{
    "name": "marrow/ui",
    "description": "A Tailwind + Alpine.js component library for the Marrow HMVC framework.",
    "type": "library",
    "license": "MIT",
    "keywords": ["marrow", "framework", "ui", "components", "tailwind", "alpinejs", "twig"],
    "homepage": "https://github.com/marrow-framework/ui",
    "support": {
        "issues": "https://github.com/marrow-framework/ui/issues",
        "source": "https://github.com/marrow-framework/ui"
    },
    "authors": [
        {
            "name": "Aure Dulvresse",
            "email": "marrow.framework@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "marrow/framework": "^2.2"
    },
    "suggest": {
        "marrow/form-builder": "Enables the `form` component's automatic field rendering for a marrow/form-builder Form instance"
    },
    "autoload": {
        "psr-4": {
            "Marrow\\Ui\\": "src/"
        }
    },
    "extra": {
        "marrow": {
            "modules": ["Marrow\\Ui\\UiModule"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
